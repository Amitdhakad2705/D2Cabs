# Copy this file to ".env" and fill real values. NEVER commit ".env".
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/d2cabs

# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7

# Frontends allowed to call this API (comma separated, no trailing slash)
CLIENT_URLS=http://localhost:3000,http://localhost:3001

# Road distance for fare calculation (server-side). Public demo server is fine for testing only;
# before going live self-host OSRM or replace src/services/routing.service.js with Google/Mapbox.
OSRM_BASE_URL=https://router.project-osrm.org

# Used only by: npm run seed:admin
ADMIN_NAME=D2Cabs Admin
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# Razorpay - keep the SECRETS only here, never in any frontend file
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks: URL = https://YOUR-API/api/payments/webhook , events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# Email (forgot-password OTP + booking emails). Any SMTP provider (Gmail app password, Brevo, SES ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="D2Cabs <no-reply@yourdomain.com>"
ADMIN_NOTIFY_EMAIL=

# true = admin can assign a driver only after the customer paid the advance
REQUIRE_PAYMENT_BEFORE_DRIVER=false
